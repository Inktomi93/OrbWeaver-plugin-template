{
  "name": "orbweaver-plugin-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "check": "orb-plugin support --check SUPPORT.md && orb-plugin check . --source-dir src --out-dir .",
    "build": "orb-plugin build . --source-dir src --out-dir .",
    "pack": "orb-plugin pack . --source-dir src --out dist/starter.orb-plugin.zip"
  },
  "devDependencies": {
    "@orb/plugin-sdk": "https://github.com/Inktomi93/OrbWeaver/releases/download/plugin-authoring-v0.1.0/orb-plugin-sdk-0.1.0.tgz",
    "@orb/plugin-toolchain": "https://github.com/Inktomi93/OrbWeaver/releases/download/plugin-authoring-v0.1.0/orb-plugin-toolchain-0.1.0.tgz"
  }
}
